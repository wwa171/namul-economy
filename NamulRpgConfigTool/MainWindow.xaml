<Window x:Class="NamulRpgConfigTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="나물 RPG 설정 에디터 (Namul RPG Config Tool)" Height="860" Width="910"
        WindowStartupLocation="CenterScreen" Background="#1E1E2E">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#F5E0DC"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단 헤더 및 언어 선택 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                <TextBlock x:Name="TxtTitle" Text="🌱 나물 RPG 통합 설정 툴" FontSize="20" FontWeight="Bold" Foreground="#A6E3A1"/>
                <TextBlock x:Name="TxtSubtitle" Text="TShock Economy, Distance Scaling &amp; Titles GUI Editor (Vibe Coding)" FontSize="12" Foreground="#BAC2DE"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="TxtLangLabel" Text="🌐 언어 / Language: " VerticalAlignment="Center" Foreground="#CDD6F4" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbLanguage" Width="110" SelectionChanged="CmbLanguage_SelectionChanged" Background="#313244" Foreground="#11111B">
                    <ComboBoxItem Content="한국어 (KO)"/>
                    <ComboBoxItem Content="English (EN)"/>
                </ComboBox>
            </StackPanel>
        </DockPanel>

        <!-- 본문 설정 영역 (스크롤) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. 기본 경제 & 경험치 설정 -->
                <GroupBox x:Name="GrpGeneral" Header="기본 경제 및 경험치 설정">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>

                        <!-- 화폐 이름 -->
                        <Label x:Name="LblCurrencyName" Grid.Row="0" Grid.Column="0" Content="화폐 이름:"/>
                        <TextBox x:Name="TxtCurrencyName" Grid.Row="0" Grid.Column="1" Text="골드"/>

                        <!-- 정착금 -->
                        <Label x:Name="LblStartingBal" Grid.Row="0" Grid.Column="3" Content="신규 유저 정착금:"/>
                        <TextBox x:Name="TxtStartingBal" Grid.Row="0" Grid.Column="4" Text="1000"/>

                        <!-- 만렙 -->
                        <Label x:Name="LblMaxLevel" Grid.Row="1" Grid.Column="0" Content="최대 레벨 (만렙):"/>
                        <TextBox x:Name="TxtMaxLevel" Grid.Row="1" Grid.Column="1" Text="100"/>

                        <!-- 필요 경험치 기본값 -->
                        <Label x:Name="LblBaseExp" Grid.Row="1" Grid.Column="3" Content="기본 필요 경험치:"/>
                        <TextBox x:Name="TxtBaseExp" Grid.Row="1" Grid.Column="4" Text="100"/>

                        <!-- 데미지당 기본 경험치 -->
                        <Label x:Name="LblExpPerDmg" Grid.Row="2" Grid.Column="0" Content="데미지당 기본 EXP:"/>
                        <TextBox x:Name="TxtExpPerDmg" Grid.Row="2" Grid.Column="1" Text="0.02"/>

                        <!-- 데미지당 기본 골드 -->
                        <Label x:Name="LblMoneyPerDmg" Grid.Row="2" Grid.Column="3" Content="데미지당 기본 골드:"/>
                        <TextBox x:Name="TxtMoneyPerDmg" Grid.Row="2" Grid.Column="4" Text="0.01"/>

                        <!-- 보스 몬스터 배율 -->
                        <Label x:Name="LblBossMult" Grid.Row="3" Grid.Column="0" Content="보스 몬스터 배율:"/>
                        <TextBox x:Name="TxtBossMult" Grid.Row="3" Grid.Column="1" Text="3.0"/>
                    </Grid>
                </GroupBox>

                <!-- 2. 스폰 거리 비례 몬스터 강화 설정 -->
                <GroupBox x:Name="GrpDistance" Header="스폰 지점 거리 비례 몬스터 강화 (Distance Scaling)">
                    <StackPanel>
                        <CheckBox x:Name="ChkDistanceEnabled" Content="거리 비례 몬스터 강화 활성화" Foreground="#CDD6F4" FontWeight="Bold" Margin="0,4,0,10" IsChecked="True"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>

                            <!-- 거리 계산 방식 -->
                            <Label x:Name="LblDistanceMode" Grid.Row="0" Grid.Column="0" Content="거리 계산 방식:"/>
                            <ComboBox x:Name="CmbDistanceMode" Grid.Row="0" Grid.Column="1" Background="#313244" Foreground="#11111B" SelectedIndex="0">
                                <ComboBoxItem Content="Euclidean (직선거리)"/>
                                <ComboBoxItem Content="HorizontalOnly (좌우거리)"/>
                                <ComboBoxItem Content="Taxicab (맨해튼거리)"/>
                            </ComboBox>

                            <!-- 안전지대 반경 -->
                            <Label x:Name="LblSafeZone" Grid.Row="0" Grid.Column="3" Content="안전 지대 반경 (타일):"/>
                            <TextBox x:Name="TxtSafeZone" Grid.Row="0" Grid.Column="4" Text="200"/>

                            <!-- 강화 스텝 타일 단위 -->
                            <Label x:Name="LblStepTiles" Grid.Row="1" Grid.Column="0" Content="강화 스텝 거리 (타일):"/>
                            <TextBox x:Name="TxtStepTiles" Grid.Row="1" Grid.Column="1" Text="100"/>

                            <!-- 스텝당 체력 증가율 -->
                            <Label x:Name="LblHpStep" Grid.Row="1" Grid.Column="3" Content="스텝당 체력 증가 (+%):"/>
                            <TextBox x:Name="TxtHpStep" Grid.Row="1" Grid.Column="4" Text="0.05"/>

                            <!-- 스텝당 공격력 증가율 -->
                            <Label x:Name="LblDmgStep" Grid.Row="2" Grid.Column="0" Content="스텝당 공격력 증가 (+%):"/>
                            <TextBox x:Name="TxtDmgStep" Grid.Row="2" Grid.Column="1" Text="0.03"/>

                            <!-- 최대 체력 배율 -->
                            <Label x:Name="LblMaxHpMult" Grid.Row="2" Grid.Column="3" Content="최대 체력 상한선 (배수):"/>
                            <TextBox x:Name="TxtMaxHpMult" Grid.Row="2" Grid.Column="4" Text="10.0"/>

                            <!-- 최대 공격력 배율 -->
                            <Label x:Name="LblMaxDmgMult" Grid.Row="3" Grid.Column="0" Content="최대 공격력 상한선 (배수):"/>
                            <TextBox x:Name="TxtMaxDmgMult" Grid.Row="3" Grid.Column="1" Text="5.0"/>

                            <!-- 보상 연동 여부 -->
                            <CheckBox x:Name="ChkScaleReward" Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2" Content="거리로 강해진 만큼 경험치/골드 보상도 비례 증가" Foreground="#CDD6F4" VerticalAlignment="Center" IsChecked="True"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 3. 파티/팀 레이드 사냥 공유 설정 -->
                <GroupBox x:Name="GrpParty" Header="파티/팀 사냥 경험치·골드 공유 설정 (Party Hunting)">
                    <StackPanel>
                        <CheckBox x:Name="ChkPartyEnabled" Content="파티 사냥 경험치/골드 공유 활성화 (관리자 On/Off)" Foreground="#CDD6F4" FontWeight="Bold" Margin="0,4,0,10" IsChecked="True"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>

                            <Label x:Name="LblPartyRadius" Grid.Row="0" Grid.Column="0" Content="공유 가능 반경 (타일):"/>
                            <TextBox x:Name="TxtPartyRadius" Grid.Row="0" Grid.Column="1" Text="100"/>

                            <Label x:Name="LblPartyBonus" Grid.Row="0" Grid.Column="3" Content="팀원당 보너스 경험치 (+%):"/>
                            <TextBox x:Name="TxtPartyBonus" Grid.Row="0" Grid.Column="4" Text="0.15"/>

                            <CheckBox x:Name="ChkPartyMoney" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="골드도 팀원들과 균등 분배" Foreground="#CDD6F4" VerticalAlignment="Center" IsChecked="True"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 4. 칭호 & 업적 시스템 설정 -->
                <GroupBox x:Name="GrpTitles" Header="칭호 &amp; 업적 시스템 (Titles &amp; Achievements)">
                    <StackPanel>
                        <CheckBox x:Name="ChkTitlesEnabled" Content="채팅 칭호 접두사 및 스펙 보너스 시스템 활성화" Foreground="#CDD6F4" FontWeight="Bold" Margin="0,4,0,10" IsChecked="True"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>

                            <Label x:Name="LblPrefixFormat" Grid.Row="0" Grid.Column="0" Content="칭호 접두사 포맷:"/>
                            <TextBox x:Name="TxtPrefixFormat" Grid.Row="0" Grid.Column="1" Text="[{0}]"/>

                            <TextBlock x:Name="TxtTitleHelp" Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" Text="* 세부 칭호 목록/보너스는 titles.json 파일에서 편집 가능합니다." Foreground="#BAC2DE" VerticalAlignment="Center" FontSize="11"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 5. 생활 콘텐츠 & 장비 재련 설정 -->
                <GroupBox x:Name="GrpLifeSkills" Header="생활 콘텐츠(채광/낚시) 및 장비 재련(강화)">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>

                        <CheckBox x:Name="ChkMiningEnabled" Grid.Row="0" Grid.Column="0" Content="광물 채광 보상 활성화" Foreground="#CDD6F4" FontWeight="Bold" IsChecked="True"/>
                        <CheckBox x:Name="ChkFishingEnabled" Grid.Row="0" Grid.Column="3" Content="낚시 성공 보상 활성화" Foreground="#CDD6F4" FontWeight="Bold" IsChecked="True"/>

                        <CheckBox x:Name="ChkEnhanceEnabled" Grid.Row="1" Grid.Column="0" Content="장비 재련(/강화) 활성화" Foreground="#CDD6F4" FontWeight="Bold" IsChecked="True"/>
                        <Label x:Name="LblEnhanceCost" Grid.Row="1" Grid.Column="3" Content="기본 강화 비용 (골드):"/>
                        <TextBox x:Name="TxtEnhanceCost" Grid.Row="1" Grid.Column="4" Text="1000"/>

                        <CheckBox x:Name="ChkPassivesEnabled" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="직업별 고유 지속 패시브 버프 활성화" Foreground="#CDD6F4" FontWeight="Bold" IsChecked="True"/>
                    </Grid>
                </GroupBox>

                <!-- 6. 파일 경로 안내 -->
                <TextBlock x:Name="TxtFilePathInfo" Text="현재 불러온 경로: (기본값 세팅됨)" Foreground="#9399B2" FontSize="11" Margin="2,0,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 하단 액션 버튼 바 -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button x:Name="BtnOpen" Content="📂 설정 파일 열기 (Load JSON)" Click="BtnOpen_Click" Background="#45475A" Foreground="#CDD6F4" Margin="0,0,10,0"/>
            <Button x:Name="BtnSaveAs" Content="💾 다른 이름으로 저장 (Save As)" Click="BtnSaveAs_Click" Background="#585B70" Foreground="#CDD6F4" Margin="0,0,10,0"/>
            <Button x:Name="BtnSave" Content="✅ 설정 저장 (Save Config)" Click="BtnSave_Click" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>
