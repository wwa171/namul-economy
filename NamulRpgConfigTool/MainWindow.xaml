<Window x:Class="NamulRpgConfigTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="나물 RPG 설정 에디터 (Namul RPG Config Tool)" Height="760" Width="870"
        WindowStartupLocation="CenterScreen" Background="#1E1E2E">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#F5E0DC"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단 헤더 및 언어 선택 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                <TextBlock x:Name="TxtTitle" Text="🌱 나물 RPG 통합 설정 툴" FontSize="20" FontWeight="Bold" Foreground="#A6E3A1"/>
                <TextBlock x:Name="TxtSubtitle" Text="TShock Economy &amp; Distance Scaling GUI Editor" FontSize="12" Foreground="#BAC2DE"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="TxtLangLabel" Text="🌐 언어 / Language: " VerticalAlignment="Center" Foreground="#CDD6F4" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbLanguage" Width="110" SelectionChanged="CmbLanguage_SelectionChanged" Background="#313244" Foreground="#11111B">
                    <ComboBoxItem Content="한국어 (KO)"/>
                    <ComboBoxItem Content="English (EN)"/>
                </ComboBox>
            </StackPanel>
        </DockPanel>

        <!-- 본문 설정 영역 (스크롤) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. 기본 경제 & 경험치 설정 -->
                <GroupBox x:Name="GrpGeneral" Header="기본 경제 및 경험치 설정">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>

                        <!-- 화폐 이름 -->
                        <Label x:Name="LblCurrencyName" Grid.Row="0" Grid.Column="0" Content="화폐 이름:"/>
                        <TextBox x:Name="TxtCurrencyName" Grid.Row="0" Grid.Column="1" Text="골드"/>

                        <!-- 정착금 -->
                        <Label x:Name="LblStartingBal" Grid.Row="0" Grid.Column="3" Content="신규 유저 정착금:"/>
                        <TextBox x:Name="TxtStartingBal" Grid.Row="0" Grid.Column="4" Text="1000"/>

                        <!-- 만렙 -->
                        <Label x:Name="LblMaxLevel" Grid.Row="1" Grid.Column="0" Content="최대 레벨 (만렙):"/>
                        <TextBox x:Name="TxtMaxLevel" Grid.Row="1" Grid.Column="1" Text="100"/>

                        <!-- 필요 경험치 기본값 -->
                        <Label x:Name="LblBaseExp" Grid.Row="1" Grid.Column="3" Content="기본 필요 경험치:"/>
                        <TextBox x:Name="TxtBaseExp" Grid.Row="1" Grid.Column="4" Text="100"/>

                        <!-- 데미지당 기본 경험치 -->
                        <Label x:Name="LblExpPerDmg" Grid.Row="2" Grid.Column="0" Content="데미지당 기본 EXP:"/>
                        <TextBox x:Name="TxtExpPerDmg" Grid.Row="2" Grid.Column="1" Text="0.02"/>

                        <!-- 데미지당 기본 골드 -->
                        <Label x:Name="LblMoneyPerDmg" Grid.Row="2" Grid.Column="3" Content="데미지당 기본 골드:"/>
                        <TextBox x:Name="TxtMoneyPerDmg" Grid.Row="2" Grid.Column="4" Text="0.01"/>

                        <!-- 보스 몬스터 배율 -->
                        <Label x:Name="LblBossMult" Grid.Row="3" Grid.Column="0" Content="보스 몬스터 배율:"/>
                        <TextBox x:Name="TxtBossMult" Grid.Row="3" Grid.Column="1" Text="3.0"/>
                    </Grid>
                </GroupBox>

                <!-- 2. 스폰 거리 비례 몬스터 강화 설정 -->
                <GroupBox x:Name="GrpDistance" Header="스폰 지점 거리 비례 몬스터 강화 (Distance Scaling)">
                    <StackPanel>
                        <CheckBox x:Name="ChkDistanceEnabled" Content="거리 비례 몬스터 강화 활성화" Foreground="#CDD6F4" FontWeight="Bold" Margin="0,4,0,10" IsChecked="True"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>

                            <!-- 거리 계산 방식 -->
                            <Label x:Name="LblDistanceMode" Grid.Row="0" Grid.Column="0" Content="거리 계산 방식:"/>
                            <ComboBox x:Name="CmbDistanceMode" Grid.Row="0" Grid.Column="1" Background="#313244" Foreground="#11111B" SelectedIndex="0">
                                <ComboBoxItem Content="Euclidean (직선거리)"/>
                                <ComboBoxItem Content="HorizontalOnly (좌우거리)"/>
                                <ComboBoxItem Content="Taxicab (맨해튼거리)"/>
                            </ComboBox>

                            <!-- 안전지대 반경 -->
                            <Label x:Name="LblSafeZone" Grid.Row="0" Grid.Column="3" Content="안전 지대 반경 (타일):"/>
                            <TextBox x:Name="TxtSafeZone" Grid.Row="0" Grid.Column="4" Text="200"/>

                            <!-- 강화 스텝 타일 단위 -->
                            <Label x:Name="LblStepTiles" Grid.Row="1" Grid.Column="0" Content="강화 스텝 거리 (타일):"/>
                            <TextBox x:Name="TxtStepTiles" Grid.Row="1" Grid.Column="1" Text="100"/>

                            <!-- 스텝당 체력 증가율 -->
                            <Label x:Name="LblHpStep" Grid.Row="1" Grid.Column="3" Content="스텝당 체력 증가 (+%):"/>
                            <TextBox x:Name="TxtHpStep" Grid.Row="1" Grid.Column="4" Text="0.05"/>

                            <!-- 스텝당 공격력 증가율 -->
                            <Label x:Name="LblDmgStep" Grid.Row="2" Grid.Column="0" Content="스텝당 공격력 증가 (+%):"/>
                            <TextBox x:Name="TxtDmgStep" Grid.Row="2" Grid.Column="1" Text="0.03"/>

                            <!-- 최대 체력 배율 -->
                            <Label x:Name="LblMaxHpMult" Grid.Row="2" Grid.Column="3" Content="최대 체력 상한선 (배수):"/>
                            <TextBox x:Name="TxtMaxHpMult" Grid.Row="2" Grid.Column="4" Text="10.0"/>

                            <!-- 최대 공격력 배율 -->
                            <Label x:Name="LblMaxDmgMult" Grid.Row="3" Grid.Column="0" Content="최대 공격력 상한선 (배수):"/>
                            <TextBox x:Name="TxtMaxDmgMult" Grid.Row="3" Grid.Column="1" Text="5.0"/>

                            <!-- 보상 연동 여부 -->
                            <CheckBox x:Name="ChkScaleReward" Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2" Content="거리로 강해진 만큼 경험치/골드 보상도 비례 증가" Foreground="#CDD6F4" VerticalAlignment="Center" IsChecked="True"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 3. 광물 채광(Mining) 생활 콘텐츠 설정 -->
                <GroupBox x:Name="GrpMining" Header="광물 채광(Mining) 생활 콘텐츠 설정">
                    <StackPanel>
                        <CheckBox x:Name="ChkMiningEnabled" Content="광물 채광 시 경험치/골드 보상 활성화" Foreground="#CDD6F4" FontWeight="Bold" Margin="0,4,0,10" IsChecked="True"/>
                        <CheckBox x:Name="ChkMiningChat" Content="채광 보상 획득 시 개인 채팅 알림 표시" Foreground="#CDD6F4" Margin="0,0,0,10" IsChecked="False"/>
                        <TextBlock x:Name="TxtMiningDesc" Text="* 구리/철/금/백금/코발트/미스릴/아다만타이트/클로로파이트 등 광물을 캘 때마다 보상이 지급됩니다." Foreground="#BAC2DE" FontSize="11" Margin="2,0,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- 4. 직업별 패시브 버프 설정 -->
                <GroupBox x:Name="GrpJobPassives" Header="직업별 패시브 버프 시스템">
                    <StackPanel>
                        <CheckBox x:Name="ChkPassivesEnabled" Content="직업별 패시브 상시 버프 활성화" Foreground="#CDD6F4" FontWeight="Bold" Margin="0,4,0,10" IsChecked="True"/>
                        <TextBlock x:Name="TxtPassivesDesc" Text="* 전사(철피부+재생), 궁수(신속+양궁), 마법사(마력재생+마법강화), 소환사(하수인증가+신속) 효과가 상시 유지됩니다." Foreground="#BAC2DE" FontSize="11" Margin="2,0,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- 5. 파일 경로 안내 -->
                <TextBlock x:Name="TxtFilePathInfo" Text="현재 불러온 경로: (기본값 세팅됨)" Foreground="#9399B2" FontSize="11" Margin="2,0,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 하단 액션 버튼 바 -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button x:Name="BtnOpen" Content="📂 설정 파일 열기 (Load JSON)" Click="BtnOpen_Click" Background="#45475A" Foreground="#CDD6F4" Margin="0,0,10,0"/>
            <Button x:Name="BtnSaveAs" Content="💾 다른 이름으로 저장 (Save As)" Click="BtnSaveAs_Click" Background="#585B70" Foreground="#CDD6F4" Margin="0,0,10,0"/>
            <Button x:Name="BtnSave" Content="✅ 설정 저장 (Save Config)" Click="BtnSave_Click" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>
